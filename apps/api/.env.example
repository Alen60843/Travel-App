# Copy to .env and fill in. NEVER commit .env.
# Every value below is a name or a safe local example — no credentials.

# ---- application ----------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_DEFAULT_VERSION=1
SHUTDOWN_TIMEOUT_MS=15000
# Maximum time a readiness probe waits for one dependency operation.
DEPENDENCY_CHECK_TIMEOUT_MS=2000
BODY_LIMIT=1mb

# ---- PostgreSQL -----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=tripwith
DB_PASSWORD=
DB_NAME=tripwith
DB_SSL=false
# Production TLS requires a trusted CA and validates the server certificate.
# Supply PEM as one line with literal \n escapes. Never commit deployment CA
# material if it is private to your infrastructure.
DB_SSL_CA=
# Local development/test only. Startup rejects this setting in production.
DB_SSL_INSECURE_LOCAL=false
DB_LOGGING=false
DB_POOL_MAX=10

# ---- current required consent policies -----------------------------------
# Server-owned identifiers displayed with the corresponding published text.
CURRENT_TOS_VERSION=2026-08-21
CURRENT_PRIVACY_POLICY_VERSION=2026-08-21

# ---- Redis ----------------------------------------------------------------
# TWO SEPARATE INSTANCES IN PRODUCTION. maxmemory-policy is a server-level
# setting, so separate logical databases cannot give queues `noeviction` while
# giving the cache `allkeys-lru`. See infra/docker-compose.yml.
REDIS_QUEUE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380
QUEUE_PREFIX=tripwith

# ---- transactional outbox relay -------------------------------------------
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# How long a published-but-unacknowledged row waits before it is re-driven.
OUTBOX_LEASE_MS=300000

# ---- Firebase -------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- object storage -------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=tripwith-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- observability --------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
SERVICE_NAME=tripwith-api
