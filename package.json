{
  "name": "tripwith",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "scripts": {
    "agents:plan": "pnpm --filter @tripwith/agent-orchestrator plan",
    "agents:run": "pnpm --filter @tripwith/agent-orchestrator start",
    "agents:resume": "pnpm --filter @tripwith/agent-orchestrator resume",
    "agents:status": "pnpm --filter @tripwith/agent-orchestrator status",
    "agents:metrics": "pnpm --filter @tripwith/agent-orchestrator metrics",
    "agents:cleanup": "pnpm --filter @tripwith/agent-orchestrator cleanup",
    "agents:recover-handoffs": "pnpm --filter @tripwith/agent-orchestrator recover-handoffs",
    "agents:retry-integration": "pnpm --filter @tripwith/agent-orchestrator retry-integration",
    "agents:apply-integration-fix": "pnpm --filter @tripwith/agent-orchestrator apply-integration-fix",
    "check:enums": "node scripts/check-enum-parity.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tripwith/api migration:run",
    "db:revert": "pnpm --filter @tripwith/api migration:revert",
    "db:verify": "pnpm --filter @tripwith/api db:verify",
    "verify": "pnpm run check:enums && pnpm run test && pnpm run db:verify",
    "test": "pnpm --filter @tripwith/shared test"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
